# Copy to apps/api/.env for local development.

# Explicit development demo identity. Beta has no demo fallback.
APP_MODE=demo

# "database" (PostgreSQL via Prisma) or "demo" (in-memory DEMO dataset, no database needed).
DATA_SOURCE=database

# Matches docker-compose.yml. Never commit real credentials.
DATABASE_URL=postgresql://runsaturday:runsaturday@localhost:5432/runsaturday

HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Time zone used to decide what "next Saturday" means.
APP_TIME_ZONE=Europe/London

# For real accounts, use APP_MODE=beta, DATA_SOURCE=database and configure:
# AUTH_BASE_URL=https://your-public-frontend-origin
# AUTH_SECRET=<random secret, at least 32 characters; never commit>
# EMAIL_TRANSPORT=resend
# EMAIL_API_KEY=<provider secret; never commit>
# EMAIL_FROM=5K Compass <auth@your-verified-domain>
# Every public beta requires HTTPS, even with NODE_ENV omitted; cookies are Secure.
# Production additionally requires NODE_ENV=production and forbids the local HTTP exception.
# Local/test HTTP only: AUTH_ALLOW_INSECURE_LOCAL_HTTP=true and AUTH_BASE_URL with
# exact localhost, 127.0.0.1 or [::1] hostname (no URL credentials); default is false.
# Test-only transport: NODE_ENV=test EMAIL_TRANSPORT=test OTP_TEST_INBOX_PATH=/tmp/your-inbox.jsonl
# See docs/B1-authentication.md. Beta bootstrap uses db:deploy, never db:seed/db:reset.

# Default: do not trust forwarded IPs. Use only actual deployment proxy IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
# Disposable demo DB only: export ALLOW_DESTRUCTIVE_DEMO_SEED=true explicitly for db:seed.
# The seed also refuses any non-demo user or authentication Account/Session rows.
