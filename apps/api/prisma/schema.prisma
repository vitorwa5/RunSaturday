// RunSaturday database schema (Phase 1 foundation).
//
// Conventions:
// - Times are whole seconds (Int). Dates of events are calendar dates (@db.Date).
// - Unknown information is stored as NULL or an explicit UNKNOWN value, never guessed.
// - Calculated scores live in EventScore as immutable snapshots, keyed by calculation version,
//   analysis window and as-of date, so formulas can change and history can be reproduced.
// - Result rows are the canonical source of truth for positions and finish times. Summary
//   columns on EventOccurrence are a derived cache of them (see EventOccurrence).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DataSource {
  DEMO
  IMPORTED
}

/// Where a user's performance came from. Only MANUAL is written in Phase 4A; the others are
/// reserved for future connections (authorised parkrun API, CSV, Garmin, Strava).
enum PerformanceSource {
  MANUAL
  CSV
  PARKRUN_API
  GARMIN
  STRAVA
}

/// What kind of event a performance was (Phase 4A.1). The product is 5K/parkrun-focused, but a
/// performance is not assumed to be a parkrun.
enum PerformanceType {
  PARKRUN
  ROAD_RACE
  OTHER_RACE
}

enum Surface {
  TARMAC
  TRAIL
  GRASS
  MIXED
  UNKNOWN
}

enum CourseType {
  ONE_LAP
  TWO_LAPS
  THREE_PLUS_LAPS
  OUT_AND_BACK
  POINT_TO_POINT
  UNKNOWN
}

enum FacilityStatus {
  YES
  NO
  UNKNOWN
}

enum OccurrenceStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Outcome of validation for imported data. Only VALID data may feed score calculations.
enum DataQuality {
  UNVALIDATED
  VALID
  PARTIAL
  REJECTED
}

enum Goal {
  PB
  PLACE
  HIDDEN_GEM
  NEW_EVENT
  QUIET
  CHALLENGE
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT
}

model Event {
  id                String  @id @default(cuid())
  slug              String  @unique
  name              String
  country           String
  region            String?
  town              String?
  latitude          Float
  longitude         Float
  startLocationText String?
  /// Local start time, e.g. "09:00".
  startTime         String?

  courseType CourseType @default(UNKNOWN)
  surface    Surface    @default(UNKNOWN)
  laps       Int?
  elevationM Int?

  parking       FacilityStatus @default(UNKNOWN)
  toilets       FacilityStatus @default(UNKNOWN)
  cafe          FacilityStatus @default(UNKNOWN)
  dogs          FacilityStatus @default(UNKNOWN)
  buggies       FacilityStatus @default(UNKNOWN)
  accessibility FacilityStatus @default(UNKNOWN)

  officialUrl String?
  active      Boolean    @default(true)
  /// DEMO rows are fictional development data and must be labelled as such in the UI.
  source      DataSource @default(IMPORTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences      EventOccurrence[]
  scores           EventScore[]
  userEvents       UserEvent[]
  courseFactors    CourseFactorSnapshot[]
  userPerformances UserPerformance[]
  /// Users whose reference times were achieved here.
  lifetimePbUsers  User[]                 @relation("LifetimePbEvent")
  recentPbUsers    User[]                 @relation("RecentPbEvent")

  @@index([region])
  @@index([active])
}

/// One staging of an event on a date.
///
/// SOURCE OF TRUTH: the Result rows are canonical for individual positions and times.
/// participantCount and the *TimeSeconds columns are a DERIVED SUMMARY CACHE, written only by
/// summarizeResults() (src/domain/occurrenceSummary.ts) in the same write as the Results they
/// summarise. Never edit them independently; if they disagree with Results, Results win and
/// the cache must be recomputed. They are NULL when no results exist (e.g. CANCELLED).
model EventOccurrence {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date

  /// Derived: number of Result rows.
  participantCount  Int?
  /// Derived: finish time of the Result at position 1.
  winnerTimeSeconds Int?
  /// Derived: finish time of the Result at position 3.
  thirdTimeSeconds  Int?
  /// Derived: finish time of the Result at position 5.
  fifthTimeSeconds  Int?
  /// Derived: finish time of the Result at position 10.
  tenthTimeSeconds  Int?

  status      OccurrenceStatus @default(COMPLETED)
  dataQuality DataQuality      @default(UNVALIDATED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results Result[]

  /// One occurrence per event per date: re-imports update instead of duplicating.
  @@unique([eventId, date])
  @@index([date])
}

/// Canonical individual finishing record. See EventOccurrence for the derived summary cache.
model Result {
  id                String          @id @default(cuid())
  occurrenceId      String
  occurrence        EventOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  position          Int
  finishTimeSeconds Int
  /// Optional pseudonymous key (e.g. a salted hash) for cross-event analysis.
  /// Only populated where legally permissible. Never a name.
  athleteKey        String?
  ageGrade          Float?

  @@unique([occurrenceId, position])
  @@index([occurrenceId, finishTimeSeconds])
  @@index([athleteKey])
}

model User {
  id          String @id @default(cuid())
  displayName String

  homeLat   Float?
  homeLon   Float?
  homeLabel String?

  defaultTravelMinutes     Int     @default(30)
  /// TRANSITIONAL (Phase 4A): no longer read or written. Lifetime PB, recent best and their
  /// events are derived from UserPerformance. Kept only so the change is non-destructive;
  /// to be dropped in a later migration.
  lifetimePbSeconds        Int?
  lifetimePbEventId        String?
  lifetimePbEvent          Event?  @relation("LifetimePbEvent", fields: [lifetimePbEventId], references: [id], onDelete: SetNull)
  recentPbSeconds          Int?
  recentPbEventId          String?
  recentPbEvent            Event?  @relation("RecentPbEvent", fields: [recentPbEventId], references: [id], onDelete: SetNull)
  /// CANONICAL: an estimate of current fitness, not a performance (Runner Form Model in Phase 4B).
  current5kEstimateSeconds Int?
  preferredGoal            Goal    @default(PB)

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       UserEvent[]
  performances UserPerformance[]
}

/// CANONICAL source of a user's actual 5K performances (Phase 4A). Lifetime PB, recent best,
/// latest run, per-event PBs and visit counts are all derived from these rows.
/// Personal data: every read and write is scoped by userId.
model UserPerformance {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Where it happened: EITHER a known internal event (eventId) OR a free-text name for a course
  /// 5K Compass does not model (externalEventName). Exactly one is set (CHECK constraint in the
  /// migration); no Event row is ever created just to hold an external race.
  /// Restrict: removing an event must never silently delete someone's history.
  eventId           String?
  event             Event?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  externalEventName String?

  date              DateTime          @db.Date
  /// Architectural preparation only: every performance is 5000 m for now. Course Speed Factors
  /// are 5K-specific and must never be applied to other distances.
  distanceMeters    Int               @default(5000)
  performanceType   PerformanceType   @default(PARKRUN)
  finishTimeSeconds Int
  source            PerformanceSource @default(MANUAL)
  /// Identifier from an external source (future imports), for de-duplication.
  externalResultId  String?
  /// True only when confirmed by an authoritative source; manual entries are unverified.
  verified          Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deterministic duplicate key computed by the app (services/performanceKey.ts):
  ///   internal: "event:<eventId>|<date>|<distanceMeters>"
  ///   external: "external:<normalised name>|<date>|<distanceMeters>"
  /// Unique per user. It never relies on how SQL treats NULLs in unique indexes.
  duplicateKey String

  /// One performance per user, location, date and distance.
  @@unique([userId, duplicateKey])
  /// Import idempotency: one row per external result per source (NULL for manual entries).
  @@unique([userId, source, externalResultId])
  @@index([userId, date])
  @@index([eventId])
}

/// Per-user event preferences. CANONICAL: favourite. TRANSITIONAL (Phase 4A, no longer read):
/// visited, visitCount and personalBestSeconds, which are now derived from UserPerformance.
model UserEvent {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  visited             Boolean @default(false)
  favourite           Boolean @default(false)
  visitCount          Int     @default(0)
  personalBestSeconds Int?

  updatedAt DateTime @updatedAt

  @@id([userId, eventId])
  @@index([eventId])
}

/// Pre-calculated score snapshot. Clients read these; they are never computed per request.
///
/// A snapshot is identified by (event, calculationVersion, windowDays, asOfDate), so one event
/// can hold 30/60/90/365-day (and later all-time) scores side by side, and keep earlier
/// snapshots for reproducibility and trend charts. Snapshots are written once, not updated.
model EventScore {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  pbScore          Float?
  difficultyScore  Float?
  competitionScore Float?
  gemBaseScore     Float?

  pbConfidence          ConfidenceLevel @default(INSUFFICIENT)
  competitionConfidence ConfidenceLevel @default(INSUFFICIENT)

  /// Normalised (0–100) component values behind each score, keyed by component name.
  components Json?

  averageParticipants Float?
  /// Number of event occurrences used.
  sampleSize          Int    @default(0)

  /// e.g. "pb_score_v1". "demo_v0" marks hand-written demo values.
  calculationVersion String
  /// Analysis window in days: 30, 60, 90 or 365. 0 is reserved for all-time.
  windowDays         Int
  /// Last calendar date of data included: the window covers (asOfDate - windowDays, asOfDate].
  asOfDate           DateTime @db.Date
  /// When the snapshot was computed (audit only; asOfDate defines the data used).
  calculatedAt       DateTime @default(now())

  @@unique([eventId, calculationVersion, windowDays, asOfDate])
  @@index([calculationVersion, windowDays, asOfDate])
}

/// Course Speed Factor snapshot (course_speed_v1): observed course speed from matched runners.
/// Kept apart from EventScore because a factor is a multiplier around 1.000 with its own
/// uncertainty (bootstrap draws), not a 0–100 score.
model CourseFactorSnapshot {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  version    String
  windowDays Int
  asOfDate   DateTime @db.Date

  /// exp(θ); < 1 historically faster than the cohort centre, > 1 slower. Null = limited data.
  factor              Float?
  logFactor           Float?
  /// Runner-bootstrap replicate log-factors, index-aligned across events in the same run.
  bootstrapLogFactors Float[]

  matchedRunners  Int
  comparisons     Int
  connectedEvents Int
  medianGapDays   Float?
  dispersion      Float?

  confidence      ConfidenceLevel
  confidenceScore Int
  /// Full breakdown (confidence factors, reasons) for "How it's calculated".
  breakdown       Json

  calculatedAt DateTime @default(now())

  @@unique([eventId, version, windowDays, asOfDate])
  @@index([version, windowDays, asOfDate])
}
